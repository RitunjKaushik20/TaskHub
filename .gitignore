# Environment variables (NEVER commit secrets)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Node modules / Dependencies
node_modules/
**/node_modules/
package-lock.json.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production build artifacts
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Uploads / user generated media
backend/uploads/*
!backend/uploads/.gitkeep

# macOS & OS artifacts
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db

# IDE & Editor caches
.vscode/
.idea/
*.swp
*.swo
*.log
